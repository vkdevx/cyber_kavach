# OneWay Sentinel Configuration Environment Variables

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Storage Configuration
DATABASE_URL=sqlite:///./oneway_sentinel.db
DATABASE_WAL_MODE=true

# Capture & Interface Configuration
CAPTURE_INTERFACE=eth0
PROMISCUOUS_MODE=true

# Pipeline & Window Configuration
FLOW_WINDOW_SECONDS=5.0
ALERT_THRESHOLD=40
CRITICAL_THRESHOLD=80

# Risk Weights Configuration
WEIGHT_SUPERVISED_RF=0.60
WEIGHT_UNSUPERVISED_IF=0.40

# Threat Intelligence Data Directory
THREAT_INTEL_DIR=./data/threat_intel
MAXMIND_GEOIP_DB=./data/threat_intel/GeoLite2-City.mmdb
