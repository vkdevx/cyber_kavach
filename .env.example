# CyberKavach Configuration
# Copy this file to .env and update values for your system

# ── Server ───────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./oneway_sentinel.db
DATABASE_WAL_MODE=true

# ── Network Interface ────────────────────────────────
# Windows: run Get-NetAdapter in PowerShell to find your interface name
#   Common values: Wi-Fi, Ethernet, "Wi-Fi 2"
# Linux:   run ip link show
#   Common values: eth0, wlan0, ens33
CAPTURE_INTERFACE=Wi-Fi

PROMISCUOUS_MODE=true

# ── Pipeline ─────────────────────────────────────────
FLOW_WINDOW_SECONDS=10.0
ALERT_THRESHOLD=50
CRITICAL_THRESHOLD=80

# ── Risk Weights ─────────────────────────────────────
WEIGHT_SUPERVISED_RF=0.60
WEIGHT_UNSUPERVISED_IF=0.40

# ── Threat Intelligence ──────────────────────────────
THREAT_INTEL_DIR=./data/threat_intel
# GeoIP DB (optional — for map feature):
# Download GeoLite2-City.mmdb from https://maxmind.com and place here:
MAXMIND_GEOIP_DB=./data/threat_intel/GeoLite2-City.mmdb
